# ==========================================
# macOS e Sistema Operacional
# ==========================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ==========================================
# Dependências de Pacotes (Node.js)
# ==========================================
node_modules/
backend/node_modules/
frontend/node_modules/
yarn.lock
yarn-error.log
npm-debug.log*
yarn-debug.log*
lerna-debug.log*

# ==========================================
# Compilações e Builds
# ==========================================
dist/
build/
backend/dist/
frontend/build/
frontend/dist/

# ==========================================
# Arquivos de Variáveis de Ambiente e Segredos
# ==========================================
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
*.pem

# Certificados de pagamentos (ignorar chaves .p12 por segurança)
backend/certs/*.p12
!backend/certs/.gitkeep

# ==========================================
# Logs e Cobertura de Testes
# ==========================================
*.log
backend/combined.log
logs/
coverage/
.nyc_output/

# ==========================================
# Arquivos Públicos / Uploads Dinâmicos do Backend
# ==========================================
backend/public/*
!backend/public/.gitkeep
backend/private/*
!backend/private/.gitkeep

# ==========================================
# Sessões de WhatsApp e Cache
# ==========================================
.wwebjs_auth/
.wwebjs_cache/
tokens/
sessions/
backend/tokens/
backend/sessions/

# ==========================================
# IDEs e Ferramentas de Desenvolvimento
# ==========================================
.vscode/
.idea/
*.sw?
.gemini/
